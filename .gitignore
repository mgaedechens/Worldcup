# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Data ---
# Raw data is downloaded by scripts (reproducible), not committed.
# Processed data is regenerated from raw, so it is also ignored.
data/raw/*
data/processed/*
# Keep the folders in git via .gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
# External data (small, curated by hand: WC2026 fixtures/teams) IS committed.

# --- Models / artifacts ---
models/*.pkl
models/*.joblib
*.joblib

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Visual QA artifacts (screenshots, browser profiles) ---
reports/chrome-qa-profile/
reports/visual-*.png
